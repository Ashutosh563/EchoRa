# ECHORA Configuration
# Generated by `npm run setup` or manually configured.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

